{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "render-worker/Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c \"export HYPERFRAMES_BROWSER_PATH=$(cat /tmp/chromium.path) && npm start\"",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
