{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@shared/carousel/*": ["src/lib/carousel/*"],
      "@shared/broll/*": ["src/lib/broll/*"]
    }
  },
  "include": [
    "src/**/*",
    "../src/lib/carousel/**/*",
    "../src/lib/broll/**/*"
  ]
}
