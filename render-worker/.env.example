# Required for the worker to operate.
# Set these as Railway service env vars (or copy to .env for local dev).

# Supabase service role -- needed to upload renders bypassing RLS
SUPABASE_URL=https://zsbligbfsmdwbxcvoysu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Where to POST callbacks when a slide finishes
SUPABASE_FUNCTIONS_URL=https://zsbligbfsmdwbxcvoysu.functions.supabase.co

# HMAC secret shared with start-carousel-render and complete-carousel-render
# edge functions. Generate with: openssl rand -hex 32
RENDER_WORKER_SECRET=

# Express port (Railway injects this automatically; default 8080)
PORT=8080

# Optional -- override the chromium path Playwright found at build time.
# Only set if the auto-detect fails. Default reads /tmp/chromium.path.
# HYPERFRAMES_BROWSER_PATH=

# Optional -- log level
LOG_LEVEL=info
